parameters         ../water4/tip4p
freeze                         WATER

vdwtype                LENNARD-JONES
radiusrule                 GEOMETRIC
radiustype                     SIGMA
radiussize                  DIAMETER
epsilonrule                GEOMETRIC
dielectric                    1.0000

a-axis                          18.6
cutoff                           8.0
taper                            7.0
list-buffer                      1.0

chargeterm                      none
lj-softcore               0.7 3 1 2

lambda-deriv2

ligand                         -1 4
vdw-lmda-map                    exp
vdw-lmda-exp                      1
lambda                         0.60
