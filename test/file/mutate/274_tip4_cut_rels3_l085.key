parameters         ../water4/tip4p
freeze                         WATER

vdwtype                LENNARD-JONES
radiusrule                 GEOMETRIC
radiustype                     SIGMA
radiussize                  DIAMETER
epsilonrule                GEOMETRIC
dielectric                    1.0000

a-axis                          18.6
cutoff                           8.0
taper                            7.0
list-buffer                      1.0

lambda-deriv2

ligand1                        -1 4
ligand2                        -5 8
rel-stage              lig2 0.0 0.3
rel-stage              vdwm 0.3 0.7
rel-stage              lig1 0.7 1.0
lambda                         0.85
